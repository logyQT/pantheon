package com.logy.pantheon.features.commands.hackgame;

import com.logy.pantheon.config.ModuleConfig;
import com.logy.pantheon.config.ModuleRegistry;
import com.logy.pantheon.config.gui.SettingDefinition;
import com.logy.pantheon.features.commands.main.GameInstance;
import com.logy.pantheon.features.commands.economy.Economy;
import com.logy.pantheon.utils.ChatUtils;
import com.logy.pantheon.utils.NumberUtils;
import org.jetbrains.annotations.NotNull;

import java.util.HashMap;
import java.util.Map;

public class HackGame implements GameInstance {
    public static void register() {
        ModuleRegistry.registerModule("hack", "Hack Game", "Party Games", "java", true);
        ModuleRegistry.registerSetting("hack", SettingDefinition.bool("enabled", "Enabled", true));
        ModuleRegistry.registerSetting("hack", SettingDefinition.slider("max_attempts", "Max Attempts", 1, 10, 1, 3));
        ModuleRegistry.registerSetting("hack", SettingDefinition.slider("reward", "Reward", 10, 1000, 10, 100));
        ModuleRegistry.registerSetting("hack", SettingDefinition.slider("timeout_ms", "Timeout (s)", 5000, 60000, 1000, 18000));
        ModuleRegistry.registerSetting("hack", SettingDefinition.slider("cooldown_ms", "Cooldown (m)", 60000, 1800000, 60000, 600000));
    }

    private static final ModuleConfig CONFIG = ModuleConfig.get("hack");
    private boolean active = false;
    private String password = "";
    private String controlSum = "";
    private long startTime = 0;
    private static long globalCooldown = 0;

    private final Map<String, Integer> playerAttempts = new HashMap<>();

    public void start() {
        if (active) return;

        long now = System.currentTimeMillis();
        if (now < globalCooldown) {
            String remaining = getRemaining(now);
            ChatUtils.sendPartyMessage("Hack game is on cooldown! Wait " + remaining);
            return;
        }

        int n1 = NumberUtils.getRandomNumber(1, 9);
        int n2 = NumberUtils.getRandomNumber(1, 9);

        this.password = n1 + " " + n2;

        int sum = n1 + n2;
        int product = n1 * n2;
        this.controlSum = String.valueOf(sum) + product;

        this.active = true;
        this.startTime = now;
        this.playerAttempts.clear();

        ChatUtils.sendPartyMessage("HACK INITIALIZED! Decrypt the password.");
        ChatUtils.sendPartyMessage("Password: _ _ | Control sum: " + controlSum);
        ChatUtils.sendPartyMessage("Time: " + (CONFIG.getInt("timeout_ms") / 1000) + "s | Attempts: " + CONFIG.getInt("max_attempts") + " | Format: X Y");
    }

    private static @NotNull String getRemaining(long now) {
        long totalSeconds = (globalCooldown - now) / 1000;

        if (totalSeconds <= 0) return "0 seconds";

        long minutes = totalSeconds / 60;
        long seconds = totalSeconds % 60;

        StringBuilder sb = new StringBuilder();

        if (minutes > 0) {
            sb.append(minutes).append(minutes == 1 ? " minute " : " minutes ");
        }

        if (seconds > 0 || minutes == 0) {
            sb.append(seconds).append(seconds == 1 ? " second" : " seconds");
        }

        return sb.toString().trim();
    }

    @Override
    public void handleChat(String sender, String message) {
        if (!active) return;

        String guess = message.trim();

        if (!guess.matches("\\d\\s\\d"))  return;

        int attempts = playerAttempts.getOrDefault(sender, 0) + 1;
        if (attempts > CONFIG.getInt("max_attempts")) return;
        playerAttempts.put(sender, attempts);

        if (guess.equals(password)) {
            ChatUtils.sendPartyMessage("✔ ACCESS GRANTED! " + sender + " decrypted " + password + " | Reward: " + CONFIG.getInt("reward") + " coins");
            Economy.addMoney(sender, CONFIG.getInt("reward"));
            setGlobalCooldown();
            stop();
        } else {
            if (attempts == CONFIG.getInt("max_attempts")) {
                ChatUtils.sendPartyMessage(sender + " failed " + CONFIG.getInt("max_attempts") + " attempts!");
            }
        }
    }

    @Override
    public void update() {
        if (active && System.currentTimeMillis() - startTime > CONFIG.getInt("timeout_ms")) {
            ChatUtils.sendPartyMessage("HACK FAILED! Connection timed out. The password was: " + password);
            setGlobalCooldown();
            stop();
        }
    }

    private void setGlobalCooldown() {
        globalCooldown = System.currentTimeMillis() + CONFIG.getInt("cooldown_ms");
    }

    @Override public boolean isActive() { return active; }
    @Override public void stop() { active = false; }
}